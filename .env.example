# Salin file ini jadi `.env` di mesin lokal untuk menjalankan fungsi lembaga secara lokal.
# Nilai asli diisi di dashboard Vercel → Settings → Environment Variables.

# Strava — dapat dari https://www.strava.com/settings/api
STRAVA_CLIENT_ID=274816
STRAVA_CLIENT_SECRET=

# Hasil dari halaman /api/setup setelah memberi izin Sekali (jangan di-commit ke git!
STRAVA_REFRESH_TOKEN=

# Set '1' setelah penyiapan selesai supaya /api/setup terkunci
SETUP_TERKUNCI=1